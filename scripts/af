#!/bin/bash
# af — the pre-v4 name for the `archon` CLI, kept so the command people have been
# typing since v1 still works.
#
# A real shim rather than a symlink: this tree ships through npm pack, the Claude
# Code plugin browser and plain zip downloads, none of which reliably preserve
# symlinks (and Windows checkouts never do).
#
# ARCHON_CLI_NAME is how the invoked name reaches the CLI. `exec -a af` would set
# the PROCESS argv[0], but bash resets $0 to the script path when it runs a script
# file, so the callee cannot see it — and help text telling an `af` user to run
# `archon ...` names a command they may not have on PATH yet.
#
# Deprecated in v4.0.0. See docs/operations/MIGRATION_V4.md.

ARCHON_CLI_NAME=af exec "$(dirname "${BASH_SOURCE[0]}")/archon" "$@"
